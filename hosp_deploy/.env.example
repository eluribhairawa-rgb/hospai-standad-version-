# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_DB=hospai
POSTGRES_USER=hospai
POSTGRES_PASSWORD=CHANGE_ME
# Optional: URL-encoded form of POSTGRES_PASSWORD, only needed if it contains characters such as @ : / # %.
# Leave commented when the password is hex (openssl rand -hex 24); the backend then uses POSTGRES_PASSWORD as is.
# POSTGRES_URL_PASSWORD=

SESSION_PEPPER=CHANGE_ME

SESSION_COOKIE_SECURE=true

# Minutes of inactivity before a login expires (480 = 8 hours). Activity resets it; there is no maximum length.
SESSION_TTL_MINUTES=480

# Super Admin Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

APP_PORT=8090
APP_BIND=CHANGE_ME_SERVER_IP

# Optional features (leave commented to keep them off)
# GEMINI_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# BUCKET_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
